#include <stdio.h>
#include <string.h>

int main()
{
    char str[100], *start, *end, temp;

    // Read input string
    printf("Enter a string: ");
    fgets(str, sizeof(str), stdin);

    // Remove newline character
    str[strcspn(str, "\n")] = '\0';

    // Initialize pointers
    start = str;
    end = str + strlen(str) - 1;

    // Reverse string using pointers
    while (start < end)
    {
        temp = *start;
        *start = *end;
        *end = temp;

        start++;
        end--;
    }

    // Display reversed string
    printf("Reversed String: %s", str);

    return 0;
}